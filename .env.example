# SomnGuard Device — plantilla de entorno (HU-DEVICE-002, AC-006/AC-007).
# Copiar a .env y completar. El .env real NUNCA se versiona (ver .gitignore).
#
# Backend (HU-API-006). Base sin /api/v1, ej: http://localhost:8080
SOMNGUARD_API_URL=http://localhost:8080
#
# Provisioning: token de UN SOLO USO para el primer arranque (ADR-010).
# Lo genera el admin vía POST /api/v1/devices/provisioning-tokens.
# Solo vive en memoria: jamás se persiste ni se loguea. Tras el auto-registro
# el device opera con SOMNGUARD_DEVICE_ID + SOMNGUARD_API_KEY y deja de usarlo.
# Si el .env trae device_id + api_key válidos, el token se ignora.
SOMNGUARD_PROVISION_TOKEN=
#
# Credenciales operativas (tras self-register 201). También se guardan en
# <data_dir>/device_identity.json (chmod 600); el archivo manda sobre el env.
SOMNGUARD_DEVICE_ID=
SOMNGUARD_API_KEY=
#
# Laboratorio / desarrollo (opcionales; por defecto se leen del hardware):
# fuerzan serial_number y firmware_version del auto-registro.
SOMNGUARD_SERIAL_NUMBER=
SOMNGUARD_FIRMWARE_VERSION=
#
# Operativa
SOMNGUARD_DATA_DIR=data
SOMNGUARD_LOG_LEVEL=INFO
# Timeout HTTP contra el backend (segundos)
SOMNGUARD_BACKEND_TIMEOUT_SEC=10
