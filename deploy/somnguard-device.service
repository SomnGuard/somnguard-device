[Unit]
Description=SomnGuard edge device monitoring service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=somnguard
Group=somnguard
WorkingDirectory=/opt/somnguard-device
EnvironmentFile=/etc/somnguard/device.env
Environment=SOMNGUARD_ENV=production
Environment=SOMNGUARD_DATA_DIR=/var/lib/somnguard
ExecStart=/opt/somnguard-device/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGINT
UMask=0077
StateDirectory=somnguard
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/somnguard

[Install]
WantedBy=multi-user.target
